generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model arbitrator_conflicts {
  id                         BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  arbitrator_id              BigInt         @db.UnsignedBigInt
  conflicted_party_id        BigInt?        @db.UnsignedBigInt
  conflicted_organization_id BigInt?        @db.UnsignedBigInt
  reason                     String         @db.VarChar(500)
  declared_at                DateTime       @default(now()) @db.DateTime(0)
  expires_at                 DateTime?      @db.Date
  arbitrators                arbitrators    @relation(fields: [arbitrator_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_conflict_arbitrator")
  organizations              organizations? @relation(fields: [conflicted_organization_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_conflict_org")
  parties                    parties?       @relation(fields: [conflicted_party_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_conflict_party")

  @@index([arbitrator_id], map: "idx_conflicts_arbitrator")
  @@index([conflicted_organization_id], map: "idx_conflicts_org")
  @@index([conflicted_party_id], map: "idx_conflicts_party")
}

model arbitrator_score_history {
  id                   BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  arbitrator_id        BigInt      @db.UnsignedBigInt
  case_id              BigInt?     @db.UnsignedBigInt
  score                Decimal     @db.Decimal(5, 2)
  timeliness_component Decimal     @db.Decimal(5, 2)
  outcome_component    Decimal     @db.Decimal(5, 2)
  workload_component   Decimal     @db.Decimal(5, 2)
  calculated_at        DateTime    @default(now()) @db.DateTime(0)
  arbitrators          arbitrators @relation(fields: [arbitrator_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_score_arbitrator")
  cases                cases?      @relation(fields: [case_id], references: [id], onUpdate: Restrict, map: "fk_score_case")

  @@index([case_id], map: "fk_score_case")
  @@index([arbitrator_id], map: "idx_score_history_arbitrator")
}

model arbitrator_specializations {
  arbitrator_id  BigInt      @db.UnsignedBigInt
  specialization String      @db.VarChar(150)
  arbitrators    arbitrators @relation(fields: [arbitrator_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_spec_arbitrator")

  @@id([arbitrator_id, specialization])
}

model arbitrators {
  id                         BigInt                       @id @default(autoincrement()) @db.UnsignedBigInt
  user_id                    BigInt                       @unique(map: "uq_arbitrators_user") @db.UnsignedBigInt
  full_name                  String                       @db.VarChar(255)
  aak_membership_no          String?                      @db.VarChar(50)
  current_position           String?                      @db.VarChar(255)
  current_organization       String?                      @db.VarChar(255)
  aak_chapter                String?                      @db.VarChar(150)
  years_of_practice          Int?                         @db.UnsignedSmallInt
  phone                      String?                      @db.VarChar(50)
  bio                        String?                      @db.Text
  adr_experience_notes       String?                      @db.Text
  status                     arbitrators_status           @default(active)
  score                      Decimal                      @default(70.00) @db.Decimal(5, 2)
  cases_closed_count         Int                          @default(0) @db.UnsignedInt
  score_updated_at           DateTime?                    @db.DateTime(0)
  joined_at                  DateTime                     @db.Date
  created_at                 DateTime                     @default(now()) @db.DateTime(0)
  arbitrator_conflicts       arbitrator_conflicts[]
  arbitrator_qualifications  arbitrator_qualifications[]
  arbitrator_registrations   arbitrator_registrations[]
  arbitrator_score_history   arbitrator_score_history[]
  arbitrator_specializations arbitrator_specializations[]
  users                      users                        @relation(fields: [user_id], references: [id], onUpdate: Restrict, map: "fk_arbitrators_user")
  assignments                assignments[]
}

model assignment_extensions {
  id                                              BigInt                       @id @default(autoincrement()) @db.UnsignedBigInt
  assignment_id                                   BigInt                       @db.UnsignedBigInt
  requested_by                                    BigInt                       @db.UnsignedBigInt
  requested_at                                    DateTime                     @default(now()) @db.DateTime(0)
  reason                                          String                       @db.VarChar(500)
  previous_due_date                               DateTime                     @db.Date
  new_due_date                                    DateTime                     @db.Date
  status                                          assignment_extensions_status @default(pending)
  decided_by                                      BigInt?                      @db.UnsignedBigInt
  decided_at                                      DateTime?                    @db.DateTime(0)
  assignments                                     assignments                  @relation(fields: [assignment_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_ext_assignment")
  users_assignment_extensions_decided_byTousers   users?                       @relation("assignment_extensions_decided_byTousers", fields: [decided_by], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_ext_decider")
  users_assignment_extensions_requested_byTousers users                        @relation("assignment_extensions_requested_byTousers", fields: [requested_by], references: [id], onUpdate: Restrict, map: "fk_ext_requester")

  @@index([decided_by], map: "fk_ext_decider")
  @@index([requested_by], map: "fk_ext_requester")
  @@index([assignment_id], map: "idx_extensions_assignment")
}

model assignments {
  id                    BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  case_id               BigInt                  @db.UnsignedBigInt
  arbitrator_id         BigInt                  @db.UnsignedBigInt
  assigned_by           BigInt                  @db.UnsignedBigInt
  assigned_at           DateTime                @default(now()) @db.DateTime(0)
  due_date              DateTime                @db.Date
  status                assignments_status      @default(ongoing)
  completed_at          DateTime?               @db.DateTime(0)
  withdrawal_reason     String?                 @db.VarChar(500)
  created_at            DateTime                @default(now()) @db.DateTime(0)
  updated_at            DateTime                @default(now()) @db.DateTime(0)
  assignment_extensions assignment_extensions[]
  arbitrators           arbitrators             @relation(fields: [arbitrator_id], references: [id], onUpdate: Restrict, map: "fk_assign_arbitrator")
  users                 users                   @relation(fields: [assigned_by], references: [id], onUpdate: Restrict, map: "fk_assign_by")
  cases                 cases                   @relation(fields: [case_id], references: [id], onUpdate: Restrict, map: "fk_assign_case")

  @@index([assigned_by], map: "fk_assign_by")
  @@index([arbitrator_id], map: "idx_assignments_arbitrator")
  @@index([case_id], map: "idx_assignments_case")
  @@index([due_date], map: "idx_assignments_due_date")
  @@index([status], map: "idx_assignments_status")
}

model audit_logs {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  user_id     BigInt?  @db.UnsignedBigInt
  action      String   @db.VarChar(100)
  entity_type String   @db.VarChar(50)
  entity_id   BigInt   @db.UnsignedBigInt
  metadata    String?  @db.LongText
  ip_address  String?  @db.VarChar(45)
  created_at  DateTime @default(now()) @db.DateTime(0)
  users       users?   @relation(fields: [user_id], references: [id], onUpdate: Restrict, map: "fk_audit_user")

  @@index([created_at], map: "idx_audit_created")
  @@index([entity_type, entity_id], map: "idx_audit_entity")
  @@index([user_id], map: "idx_audit_user")
}

model case_parties {
  case_id  BigInt            @db.UnsignedBigInt
  party_id BigInt            @db.UnsignedBigInt
  role     case_parties_role
  cases    cases             @relation(fields: [case_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_casep_case")
  parties  parties           @relation(fields: [party_id], references: [id], onUpdate: Restrict, map: "fk_casep_party")

  @@id([case_id, party_id])
  @@index([party_id], map: "idx_caseparties_party")
}

model cases {
  id                                                     BigInt                     @id @default(autoincrement()) @db.UnsignedBigInt
  public_id                                              String                     @unique(map: "uq_cases_public_id") @default(dbgenerated("(uuid())")) @db.Char(36)
  case_number                                            String                     @unique(map: "uq_cases_number") @db.VarChar(50)
  project_id                                             BigInt?                    @db.UnsignedBigInt
  contract_id                                            BigInt?                    @db.UnsignedBigInt
  dispute_value                                          Decimal                    @db.Decimal(18, 2)
  currency                                               String                     @default("KES") @db.Char(3)
  category                                               String                     @db.VarChar(100)
  description                                            String                     @db.Text
  basis                                                  cases_basis
  submission_agreement_doc_id                            BigInt?                    @db.UnsignedBigInt
  sla_tier                                               cases_sla_tier
  due_date                                               DateTime?                  @db.Date
  status                                                 cases_status               @default(intake)
  filed_at                                               DateTime                   @default(now()) @db.DateTime(0)
  concluded_at                                           DateTime?                  @db.DateTime(0)
  outcome                                                cases_outcome?
  outcome_detail                                         String?                    @db.Text
  award_challenged                                       Boolean?
  created_by                                             BigInt                     @db.UnsignedBigInt
  created_at                                             DateTime                   @default(now()) @db.DateTime(0)
  updated_at                                             DateTime                   @default(now()) @db.DateTime(0)
  arbitrator_score_history                               arbitrator_score_history[]
  assignments                                            assignments[]
  case_parties                                           case_parties[]
  contracts                                              contracts?                 @relation(fields: [contract_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_cases_contract")
  users                                                  users                      @relation(fields: [created_by], references: [id], onUpdate: Restrict, map: "fk_cases_creator")
  projects                                               projects?                  @relation(fields: [project_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_cases_project")
  documents_cases_submission_agreement_doc_idTodocuments documents?                 @relation("cases_submission_agreement_doc_idTodocuments", fields: [submission_agreement_doc_id], references: [id], onUpdate: Restrict, map: "fk_cases_submission_doc")
  documents_documents_case_idTocases                     documents[]                @relation("documents_case_idTocases")

  @@index([created_by], map: "fk_cases_creator")
  @@index([submission_agreement_doc_id], map: "fk_cases_submission_doc")
  @@index([contract_id], map: "idx_cases_contract")
  @@index([due_date], map: "idx_cases_due_date")
  @@index([project_id], map: "idx_cases_project")
  @@index([status], map: "idx_cases_status")
}

model contract_parties {
  contract_id BigInt    @db.UnsignedBigInt
  party_id    BigInt    @db.UnsignedBigInt
  role        String    @db.VarChar(100)
  contracts   contracts @relation(fields: [contract_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_cp_contract")
  parties     parties   @relation(fields: [party_id], references: [id], onUpdate: Restrict, map: "fk_cp_party")

  @@id([contract_id, party_id])
  @@index([party_id], map: "fk_cp_party")
}

model contracts {
  id                      BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  project_id              BigInt             @db.UnsignedBigInt
  reference_number        String?            @db.VarChar(150)
  execution_date          DateTime?          @db.Date
  value                   Decimal?           @db.Decimal(18, 2)
  currency                String             @default("KES") @db.Char(3)
  has_arbitration_clause  Boolean            @default(false)
  arbitration_clause_text String?            @db.Text
  governing_law           String?            @db.VarChar(150)
  created_at              DateTime           @default(now()) @db.DateTime(0)
  cases                   cases[]
  contract_parties        contract_parties[]
  projects                projects           @relation(fields: [project_id], references: [id], onUpdate: Restrict, map: "fk_contracts_project")

  @@index([project_id], map: "idx_contracts_project")
}

model document_shares {
  document_id BigInt    @db.UnsignedBigInt
  party_id    BigInt    @db.UnsignedBigInt
  granted_by  BigInt    @db.UnsignedBigInt
  granted_at  DateTime  @default(now()) @db.DateTime(0)
  documents   documents @relation(fields: [document_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_share_document")
  users       users     @relation(fields: [granted_by], references: [id], onUpdate: Restrict, map: "fk_share_grantor")
  parties     parties   @relation(fields: [party_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_share_party")

  @@id([document_id, party_id])
  @@index([granted_by], map: "fk_share_grantor")
  @@index([party_id], map: "fk_share_party")
}

model documents {
  id                                                 BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  public_id                                          String                  @unique(map: "uq_documents_public_id") @default(dbgenerated("(uuid())")) @db.Char(36)
  case_id                                            BigInt                  @db.UnsignedBigInt
  uploaded_by                                        BigInt                  @db.UnsignedBigInt
  document_type                                      documents_document_type
  visibility                                         documents_visibility    @default(staff_arbitrator)
  file_name                                          String                  @db.VarChar(255)
  storage_path                                       String                  @db.VarChar(500)
  mime_type                                          String                  @db.VarChar(150)
  file_size                                          BigInt                  @db.UnsignedBigInt
  version                                            Int                     @default(1) @db.UnsignedInt
  checksum_sha256                                    String                  @db.Char(64)
  scan_status                                        documents_scan_status   @default(pending)
  created_at                                         DateTime                @default(now()) @db.DateTime(0)
  cases_cases_submission_agreement_doc_idTodocuments cases[]                 @relation("cases_submission_agreement_doc_idTodocuments")
  document_shares                                    document_shares[]
  cases_documents_case_idTocases                     cases                   @relation("documents_case_idTocases", fields: [case_id], references: [id], onUpdate: Restrict, map: "fk_documents_case")
  users                                              users                   @relation(fields: [uploaded_by], references: [id], onUpdate: Restrict, map: "fk_documents_uploader")

  @@index([uploaded_by], map: "fk_documents_uploader")
  @@index([case_id], map: "idx_documents_case")
  @@index([scan_status], map: "idx_documents_scan_status")
}

model notifications {
  id                  BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id             BigInt    @db.UnsignedBigInt
  type                String    @db.VarChar(100)
  related_entity_type String    @db.VarChar(50)
  related_entity_id   BigInt    @db.UnsignedBigInt
  message             String    @db.VarChar(500)
  read_at             DateTime? @db.DateTime(0)
  created_at          DateTime  @default(now()) @db.DateTime(0)
  users               users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_notif_user")

  @@index([user_id, read_at], map: "idx_notifications_user_unread")
}

model organizations {
  id                   BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  name                 String                 @db.VarChar(255)
  registration_number  String?                @db.VarChar(100)
  address              String?                @db.VarChar(500)
  sector               String?                @db.VarChar(150)
  created_at           DateTime               @default(now()) @db.DateTime(0)
  arbitrator_conflicts arbitrator_conflicts[]
  parties              parties[]
}

model parties {
  id                   BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  user_id              BigInt?                @db.UnsignedBigInt
  type                 parties_type
  organization_id      BigInt?                @db.UnsignedBigInt
  full_name            String                 @db.VarChar(255)
  email                String?                @db.VarChar(255)
  phone                String?                @db.VarChar(50)
  address              String?                @db.VarChar(500)
  created_at           DateTime               @default(now()) @db.DateTime(0)
  arbitrator_conflicts arbitrator_conflicts[]
  case_parties         case_parties[]
  contract_parties     contract_parties[]
  document_shares      document_shares[]
  organizations        organizations?         @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_parties_org")
  users                users?                 @relation(fields: [user_id], references: [id], onUpdate: Restrict, map: "fk_parties_user")

  @@index([user_id], map: "fk_parties_user")
  @@index([organization_id], map: "idx_parties_org")
}

model projects {
  id          BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  name        String      @db.VarChar(255)
  description String?     @db.Text
  sector      String?     @db.VarChar(150)
  value       Decimal?    @db.Decimal(18, 2)
  currency    String      @default("KES") @db.Char(3)
  location    String?     @db.VarChar(255)
  created_at  DateTime    @default(now()) @db.DateTime(0)
  cases       cases[]
  contracts   contracts[]
}

model sla_config {
  id                      BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  tier                    sla_config_tier
  currency                String          @default("KES") @db.Char(3)
  min_value               Decimal         @db.Decimal(18, 2)
  max_value               Decimal?        @db.Decimal(18, 2)
  target_days             Int             @db.UnsignedSmallInt
  approaching_days_before Decimal         @default(14.00) @db.Decimal(5, 2)
  escalation_days_after   Decimal         @default(30.00) @db.Decimal(5, 2)

  @@unique([tier, currency], map: "uq_sla_tier_currency")
}

model users {
  id                                                              BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  public_id                                                       String                  @unique(map: "uq_users_public_id") @default(dbgenerated("(uuid())")) @db.Char(36)
  email                                                           String                  @unique(map: "uq_users_email") @db.VarChar(255)
  password_hash                                                   String                  @db.VarChar(255)
  full_name                                                       String?                 @db.VarChar(255)
  role                                                            users_role
  status                                                          users_status            @default(active)
  mfa_secret                                                      String?                 @db.VarChar(255)
  mfa_enabled                                                     Boolean                 @default(false)
  failed_login_count                                              Int                     @default(0) @db.UnsignedSmallInt
  locked_until                                                    DateTime?               @db.DateTime(0)
  last_login_at                                                   DateTime?               @db.DateTime(0)
  created_at                                                      DateTime                @default(now()) @db.DateTime(0)
  updated_at                                                      DateTime                @default(now()) @db.DateTime(0)
  arbitrators                                                     arbitrators?
  assignment_extensions_assignment_extensions_decided_byTousers   assignment_extensions[] @relation("assignment_extensions_decided_byTousers")
  assignment_extensions_assignment_extensions_requested_byTousers assignment_extensions[] @relation("assignment_extensions_requested_byTousers")
  assignments                                                     assignments[]
  audit_logs                                                      audit_logs[]
  cases                                                           cases[]
  document_shares                                                 document_shares[]
  documents                                                       documents[]
  notifications                                                   notifications[]
  parties                                                         parties[]
}

model sessions {
  session_id String  @id @db.VarChar(128)
  expires    Int     @db.UnsignedInt
  data       String? @db.MediumText
}

model arbitrator_qualifications {
  id            BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  arbitrator_id BigInt      @db.UnsignedBigInt
  qualification String      @db.VarChar(500)
  arbitrators   arbitrators @relation(fields: [arbitrator_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_arb_qual_arbitrator")

  @@index([arbitrator_id], map: "idx_arb_qual_arbitrator")
}

model arbitrator_registrations {
  id                  BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  arbitrator_id       BigInt      @db.UnsignedBigInt
  body                String      @db.VarChar(150)
  registration_number String?     @db.VarChar(100)
  arbitrators         arbitrators @relation(fields: [arbitrator_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_arb_reg_arbitrator")

  @@index([arbitrator_id], map: "idx_arb_reg_arbitrator")
}

enum sla_config_tier {
  simple
  standard
  complex
}

enum case_parties_role {
  claimant
  respondent
  other
}

enum parties_type {
  individual
  organization
}

enum arbitrators_status {
  active
  inactive
  suspended
}

enum documents_document_type {
  contract_copy
  evidence
  submission_agreement
  correspondence
  award
  id_kyc
  other
}

enum users_role {
  admin
  registrar
  staff
  arbitrator
  party
}

enum documents_visibility {
  staff_arbitrator
  shared_all_parties
  uploader_only
}

enum users_status {
  active
  inactive
  suspended
}

enum assignments_status {
  ongoing
  completed
  overdue
  escalated
  withdrawn
  reassigned
}

enum assignment_extensions_status {
  pending
  approved
  rejected
}

enum cases_basis {
  contractual_clause
  mutual_agreement
}

enum cases_sla_tier {
  simple
  standard
  complex
}

enum documents_scan_status {
  pending
  clean
  infected
}

enum cases_status {
  intake
  pending_agreement
  pending_assignment
  assigned
  ongoing
  concluded
  closed
  withdrawn
}

enum cases_outcome {
  award_issued
  settled
  withdrawn
}
