# Copy to .env.test and point it at a DEDICATED test database - the test
# suite truncates every table between tests, so never point this at dev/prod.
NODE_ENV=test
PORT=3099
CORS_ORIGIN=http://localhost:5173

DATABASE_URL="mysql://aak_user:changeme@localhost:3306/aak_arbitration_test"
DB_HOST=localhost
DB_PORT=3306
DB_USER=aak_user
DB_PASSWORD=changeme
DB_NAME=aak_arbitration_test

SESSION_SECRET=test-session-secret-not-for-production-0000000000

DOCUMENT_STORAGE_PATH=./tests/tmp-storage
MAX_UPLOAD_MB=25
