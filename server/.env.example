# Server
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# MySQL - used both by Prisma (DATABASE_URL) and the session store (discrete fields below)
DATABASE_URL="mysql://aak_user:changeme@localhost:3306/aak_arbitration"
DB_HOST=localhost
DB_PORT=3306
DB_USER=aak_user
DB_PASSWORD=changeme
DB_NAME=aak_arbitration

# Sessions (cookie-based auth, session records stored in MySQL - no Redis needed)
SESSION_SECRET=change-this-to-a-long-random-string

# Document uploads
DOCUMENT_STORAGE_PATH=../storage/documents
MAX_UPLOAD_MB=25
