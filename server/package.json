{
  "name": "aak-arbitration-server",
  "version": "0.1.0",
  "private": true,
  "description": "AAK Arbitration case management API",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "prisma:pull": "prisma db pull",
    "prisma:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "job:overdue": "node dist/jobs/flagOverdueAssignments.js",
    "job:overdue:dev": "tsx src/jobs/flagOverdueAssignments.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0",
    "multer": "^2.0.1",
    "@prisma/client": "^5.20.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.7.4",
    "@types/supertest": "^6.0.2",
    "prisma": "^5.20.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^6.4.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "mysql2": "^3.24.0",
    "qs": "^6.16.0"
  }
}
